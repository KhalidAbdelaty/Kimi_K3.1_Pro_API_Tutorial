      IN["inspect_cad<br/>validity, bbox, volume"]
      RE["render_cad<br/>same 4 cameras"]
      SU["submit_cad"]
    end
  end
  subgraph Hidden["Hidden from Kimi"]
    GT["Ground-truth CadQuery<br/>+ dimension manifest"]
    EV["Evaluator<br/>voxel IoU, features,<br/>edit preservation"]
    LOG["Run log + scores"]
  end
